/// The measures of the storage of the tables, over the Tables table.
table Storage
	lineageTag: 58160a95-b32f-564d-815e-469a81fa1f8a

	/// Live, 10.2: max(0, FileSize - Deleted - FooterSize - StaleColumnSize). Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Live' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
			            "@collectedAt", CALCULATE ( MAX ( Tables[collectedAt] ) )
			        ),
			        Footprints[collectionDate] = LastDay
			    )
			RETURN
			    CALCULATE (
			        SUM ( Tables[live] ),
			        TREATAS ( Latest, Tables[sourceName], Tables[label], Tables[collectedAt] )
			    )
		displayFolder: Stack
		lineageTag: d187bd6f-a599-511b-bdb3-965d550bbffa
		formatStringDefinition = SWITCH ( TRUE (), ABS ( SELECTEDMEASURE () ) >= 1E12, "#,0,,,,.0 ""TB""", ABS ( SELECTEDMEASURE () ) >= 1E9, "#,0,,,.0 ""GB""", ABS ( SELECTEDMEASURE () ) >= 1E6, "#,0,,.0 ""MB""", ABS ( SELECTEDMEASURE () ) >= 1E3, "#,0,.0 ""KB""", "#,0 ""B""" )

	/// NonLive, 10.2: min(NonLiveFileSize, UnreferencedFileSize) when the storage was listed, else NonLiveFileSize. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Non-live' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
