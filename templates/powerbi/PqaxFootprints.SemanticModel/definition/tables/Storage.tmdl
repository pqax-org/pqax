	/// AverageFileSize, 10.3: FileSize / FileCount, over the tables of the last collection day in the period.
	measure 'Average File Size' =
			DIVIDE ( [File Size], [Files] )
		displayFolder: Files
		lineageTag: 68b605d8-b77f-52d5-a289-213cc0c9ea8e
		formatStringDefinition = SWITCH ( TRUE (), ABS ( SELECTEDMEASURE () ) >= 1E12, "#,0,,,,.0 ""TB""", ABS ( SELECTEDMEASURE () ) >= 1E9, "#,0,,,.0 ""GB""", ABS ( SELECTEDMEASURE () ) >= 1E6, "#,0,,.0 ""MB""", ABS ( SELECTEDMEASURE () ) >= 1E3, "#,0,.0 ""KB""", "#,0 ""B""" )

	/// The median of the file sizes of one table, 10.3: the size at position floor(n/2) of the sorted sizes, else FileSizes.Median. Empty for more than one table. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Median File Size' =
			IF (
			    HASONEVALUE ( Tables[label] ),
			    VAR LastDay = MAX ( Footprints[collectionDate] )
			    VAR Latest =
			        CALCULATETABLE (
			            ADDCOLUMNS (
			                SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
			                "@collectedAt", CALCULATE ( MAX ( Tables[collectedAt] ) )
			            ),
			            Footprints[collectionDate] = LastDay
			        )
			    RETURN
			        CALCULATE (
			            MAX ( Tables[fileSizesMedian] ),
			            TREATAS ( Latest, Tables[sourceName], Tables[label], Tables[collectedAt] )
			        )
			)
		displayFolder: Files
		lineageTag: 4132ca5d-a2eb-5b0b-afb1-b3747a4aa277
		formatStringDefinition = SWITCH ( TRUE (), ABS ( SELECTEDMEASURE () ) >= 1E12, "#,0,,,,.0 ""TB""", ABS ( SELECTEDMEASURE () ) >= 1E9, "#,0,,,.0 ""GB""", ABS ( SELECTEDMEASURE () ) >= 1E6, "#,0,,.0 ""MB""", ABS ( SELECTEDMEASURE () ) >= 1E3, "#,0,.0 ""KB""", "#,0 ""B""" )

	/// The files below SmallFileSize that the shares prove: SmallFileShare, 10.3, times the count of the file sizes, summed over the tables. Exact when the footprint keeps the files, else a lower bound. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Small Files At Least' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
			            "@collectedAt", CALCULATE ( MAX ( Tables[collectedAt] ) )
			        ),
			        Footprints[collectionDate] = LastDay
			    )
			RETURN
			    CALCULATE (
			        SUMX ( Tables, Tables[smallFileShare] * Tables[fileSizesCount] ),
			        TREATAS ( Latest, Tables[sourceName], Tables[label], Tables[collectedAt] )
			    )
		formatString: #,0
		displayFolder: Small files
		lineageTag: 9ce87ad4-84fb-5c4d-b71e-7f755c288cf4

	/// The files below TinyFileSize that the shares prove: TinyFileShare, 10.3, times the count of the file sizes, summed over the tables. Exact when the footprint keeps the files, else a lower bound. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Tiny Files At Least' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
			            "@collectedAt", CALCULATE ( MAX ( Tables[collectedAt] ) )
			        ),
			        Footprints[collectionDate] = LastDay
			    )
			RETURN
			    CALCULATE (
			        SUMX ( Tables, Tables[tinyFileShare] * Tables[fileSizesCount] ),
			        TREATAS ( Latest, Tables[sourceName], Tables[label], Tables[collectedAt] )
			    )
		formatString: #,0
		displayFolder: Small files
		lineageTag: a77f4646-a9b2-58fd-a1a4-0e94b7a42597

	/// SmallFileShare, 10.3, over a set of tables: the small files that the shares prove over the files counted. A lower bound when a table is at the Summary depth. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Small File Share' =
			DIVIDE (
			    [Small Files At Least],
			    VAR LastDay = MAX ( Footprints[collectionDate] )
			    VAR Latest =
			        CALCULATETABLE (
			            ADDCOLUMNS (
			                SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
			                "@collectedAt", CALCULATE ( MAX ( Tables[collectedAt] ) )
			            ),
			            Footprints[collectionDate] = LastDay
			        )
			    RETURN
			        CALCULATE (
			            SUM ( Tables[fileSizesCount] ),
			            TREATAS ( Latest, Tables[sourceName], Tables[label], Tables[collectedAt] ),
			            NOT ISBLANK ( Tables[smallFileShare] )
			        )
			)
		formatString: 0.0%
		displayFolder: Small files
		lineageTag: edefee7b-c923-540a-9b6a-97ad2ddb7b6c

	/// TinyFileShare, 10.3, over a set of tables: the very small files that the shares prove over the files counted. A lower bound when a table is at the Summary depth. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Tiny File Share' =
			DIVIDE (
			    [Tiny Files At Least],
			    VAR LastDay = MAX ( Footprints[collectionDate] )
			    VAR Latest =
			        CALCULATETABLE (
			            ADDCOLUMNS (
			                SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
			                "@collectedAt", CALCULATE ( MAX ( Tables[collectedAt] ) )
			            ),
			            Footprints[collectionDate] = LastDay
			        )
			    RETURN
			        CALCULATE (
			            SUM ( Tables[fileSizesCount] ),
			            TREATAS ( Latest, Tables[sourceName], Tables[label], Tables[collectedAt] ),
			            NOT ISBLANK ( Tables[tinyFileShare] )
			        )
			)
		formatString: 0.0%
		displayFolder: Small files
		lineageTag: de0b9d04-f11e-5f7b-a347-bb59b08ac4f9

	/// LastOptimizeAt, 10.4: the latest OPTIMIZE among the commits read. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Last Optimize At' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
			    CALCULATETABLE (
