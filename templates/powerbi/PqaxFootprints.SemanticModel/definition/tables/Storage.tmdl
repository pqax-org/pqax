	/// Waste, 10.2: NonLive + Unreferenced + Deleted + Stale, an absent component counting as 0. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Waste' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
