	/// Data, 10.2: Live + Waste. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Data' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
