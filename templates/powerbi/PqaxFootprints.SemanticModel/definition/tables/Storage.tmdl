	/// [Total] on the last collection day of the period less [Total] on the collection day before it. Empty when there is none.
	measure 'Total Change' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR PriorDay =
			    CALCULATE ( MAX ( Footprints[collectionDate] ), REMOVEFILTERS ( 'Date' ), Footprints[collectionDate] < LastDay )
			RETURN
			    IF (
			        NOT ISBLANK ( PriorDay ),
			        [Total] - CALCULATE ( [Total], REMOVEFILTERS ( 'Date' ), Footprints[collectionDate] = PriorDay )
			    )
		displayFolder: Trends
		lineageTag: 12783aaa-4754-52ae-b4d5-52c50ec5a404
		formatStringDefinition = SWITCH ( TRUE (), ABS ( SELECTEDMEASURE () ) >= 1E12, "#,0,,,,.0 ""TB""", ABS ( SELECTEDMEASURE () ) >= 1E9, "#,0,,,.0 ""GB""", ABS ( SELECTEDMEASURE () ) >= 1E6, "#,0,,.0 ""MB""", ABS ( SELECTEDMEASURE () ) >= 1E3, "#,0,.0 ""KB""", "#,0 ""B""" )

	/// [Waste] on the last collection day of the period less [Waste] on the collection day before it. Empty when there is none.
