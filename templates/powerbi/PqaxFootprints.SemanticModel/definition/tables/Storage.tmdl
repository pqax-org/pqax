	/// Total, 10.2: the sum of the seven components. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Total' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
			    CALCULATETABLE (
			        ADDCOLUMNS (
