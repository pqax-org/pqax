	/// The tables. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Table Count' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
			            "@collectedAt", CALCULATE ( MAX ( Tables[collectedAt] ) )
			        ),
			        Footprints[collectionDate] = LastDay
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS ( Tables ),
			        TREATAS ( Latest, Tables[sourceName], Tables[label], Tables[collectedAt] )
			    )
		formatString: #,0
		displayFolder: Files
		lineageTag: acd095a5-d08a-5a4f-bec8-adaee7d74917

