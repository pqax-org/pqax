		formatStringDefinition = SWITCH ( TRUE (), ABS ( SELECTEDMEASURE () ) >= 1E12, "#,0,,,,.0 ""TB""", ABS ( SELECTEDMEASURE () ) >= 1E9, "#,0,,,.0 ""GB""", ABS ( SELECTEDMEASURE () ) >= 1E6, "#,0,,.0 ""MB""", ABS ( SELECTEDMEASURE () ) >= 1E3, "#,0,.0 ""KB""", "#,0 ""B""" )

	/// Waste / Data, section 10.2. Over the tables whose Data is not empty, the sum of the part over the sum of Data. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Waste Share' =
			DIVIDE (
			    VAR LastDay = MAX ( Footprints[collectionDate] )
			    VAR Latest =
			        CALCULATETABLE (
			            ADDCOLUMNS (
			                SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
			                "@collectedAt", CALCULATE ( MAX ( Tables[collectedAt] ) )
			            ),
			            Footprints[collectionDate] = LastDay
			        )
			    RETURN
			        CALCULATE (
			            SUM ( Tables[waste] ),
			            TREATAS ( Latest, Tables[sourceName], Tables[label], Tables[collectedAt] ),
			            NOT ISBLANK ( Tables[data] )
			        ),
			    [Data]
			)
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: a456f057-20ac-545d-8361-eff5efec19ea

