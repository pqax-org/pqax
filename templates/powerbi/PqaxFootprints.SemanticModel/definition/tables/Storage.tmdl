	/// NonLiveFileCount, 6.4: the files that left the table and that the log still tracks. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Non-live Files' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
