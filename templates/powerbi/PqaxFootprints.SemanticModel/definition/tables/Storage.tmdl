	/// NonLiveOldestRemovedAt, 6.4: the earliest removal time of the non-live files, shown beside the stack as 10.4 says. Over the tables of the last collection day in the period, each table once, from its latest collection of that day.
	measure 'Non-live Oldest Removed At' =
			VAR LastDay = MAX ( Footprints[collectionDate] )
			VAR Latest =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( Tables, Tables[sourceName], Tables[label] ),
			            "@collectedAt", CALCULATE ( MAX ( Tables[collectedAt] ) )
			        ),
			        Footprints[collectionDate] = LastDay
			    )
			RETURN
			    CALCULATE (
			        MIN ( Tables[nonLiveOldestRemovedAt] ),
			        TREATAS ( Latest, Tables[sourceName], Tables[label], Tables[collectedAt] )
			    )
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Non-live and unreferenced
