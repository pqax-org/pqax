	partition Collection = m
		mode: import
		source =
				let
				    Source = PqaxTable("collectionMeasures"),
				    Selected = Table.SelectColumns(Source, {"footprintId", "collectedAt", "sources", "tables", "columns", "files", "fileSize", "rowCount", "footprint", "waste", "overhead", "depths"}, MissingField.UseNull),
				    Utc = Table.TransformColumns(Selected, List.Transform({"collectedAt"}, each {_, PqaxUtc, type datetime})),
				    Typed = Table.TransformColumnTypes(Utc, {{"footprintId", type text}, {"sources", Int64.Type}, {"tables", Int64.Type}, {"columns", Int64.Type}, {"files", Int64.Type}, {"fileSize", Int64.Type}, {"rowCount", Int64.Type}, {"footprint", type number}, {"waste", type number}, {"overhead", type number}, {"depths", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
