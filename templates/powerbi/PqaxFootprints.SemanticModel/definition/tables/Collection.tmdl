table Collection
	lineageTag: 2f9dcd8e-c779-585e-bfa2-c90b191adb83

	/// The identifier of the footprint in the export: the SHA-256 of the bytes of its PQAX file, in lowercase hex. The same file, standalone or embedded in a VPAX, has the same id.
	column footprintId
		dataType: string
		isHidden
