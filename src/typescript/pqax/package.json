{
  "name": "@pqax/pqax",
  "version": "0.2.2",
  "license": "MIT",
  "homepage": "https://pqax.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pqax-org/pqax.git",
    "directory": "src/typescript/pqax"
  },
  "description": "Reads and validates PQAX files, the footprint of Parquet tables, in a browser and in Node",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browsers": "vitest run --config vitest.browser.config.ts",
    "smoke": "node scripts/smoke.mjs --kit",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
