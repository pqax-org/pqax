<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>Pqax</RootNamespace>
    <PackageId>Pqax</PackageId>
    <Description>Reads, writes, and validates PQAX files: the footprint of Parquet tables as a zip of JSON tables. No dependency beyond zip and JSON.</Description>
    <PackageTags>pqax;parquet;delta;iceberg;lakehouse;footprint;vertipaq</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
