<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Parquet.Net 5.6.1 ships net8.0 and net10.0 assemblies only, so this package cannot target netstandard2.0. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <RootNamespace>Pqax.Collector.ParquetNet</RootNamespace>
    <PackageId>Pqax.Collector.ParquetNet</PackageId>
    <Description>Reads Delta checkpoints, which are Parquet files with nested data, with Parquet.Net, for the PQAX collector.</Description>
    <PackageTags>pqax;parquet;delta;checkpoint;onelake;fabric</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pqax.Collector\Pqax.Collector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Parquet.Net" Version="5.6.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
